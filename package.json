{
  "name": "tailzu-desktop",
  "version": "0.3.4",
  "description": "Tailzu desktop voice dictation — hotkey → record → clean → paste. Reuses the Tailzu backend.",
  "author": "Tailzu <hello@tailzu.space>",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node gen-icon.js",
    "field": "node gen-field.js",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:mac:signed": "electron-builder --mac --universal --publish never",
    "test": "node --test",
    "audiotap": "mkdir -p build && swiftc -O -target arm64-apple-macos13 -o build/audiotap-arm64 audiotap/main.swift && swiftc -O -target x86_64-apple-macos13 -o build/audiotap-x64 audiotap/main.swift && lipo -create -output build/audiotap build/audiotap-arm64 build/audiotap-x64 && rm build/audiotap-arm64 build/audiotap-x64"
  },
  "optionalDependencies": {
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "space.tailzu.desktop",
    "productName": "Tailzu",
    "files": [
      "main.js",
      "preload.js",
      "recorder.html",
      "recorder.js",
      "frontApp.js",
      "notes.html",
      "notesRecorder.js",
      "notesCore.js",
      "overlay.html",
      "overlay.js",
      "pill.html",
      "pill.js",
      "app.html",
      "sdui.js",
      "tapDetector.js",
      "pasteJoin.js",
      "speechMeter.js",
      "updater.js",
      "knobs.js",
      "neuralField.html",
      "assets/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "icon": "assets/icon-mac.png",
      "artifactName": "Tailzu.${ext}",
      "x64ArchFiles": "{**/*.node,**/audiotap}",
      "extraResources": [
        {
          "from": "build/audiotap",
          "to": "audiotap"
        }
      ],
      "hardenedRuntime": true,
      "notarize": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Tailzu records your voice to transcribe and clean it into text.",
        "NSAudioCaptureUsageDescription": "Tailzu hears your computer's sound while you take notes, so a call's other voices are in the notes.",
        "NSAppleEventsUsageDescription": "Tailzu pastes what you said into the app you are typing in.",
        "LSUIElement": true
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "appx": {
      "applicationId": "Tailzu",
      "displayName": "Tailzu",
      "backgroundColor": "#0F0D0B",
      "languages": ["en-US"],
      "addAutoLaunchExtension": false,
      "artifactName": "Tailzu.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": true,
      "artifactName": "Tailzu-Setup.${ext}",
      "uninstallDisplayName": "${productName}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "artifactName": "Tailzu.${ext}"
    }
  }
}
