{
  "name": "tailzu-desktop",
  "version": "0.1.0",
  "description": "Tailzu desktop voice dictation — hotkey → record → clean → paste. Reuses the Tailzu backend.",
  "author": "Tailzu <hello@tailzu.space>",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node gen-icon.js",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "space.tailzu.desktop",
    "productName": "Tailzu",
    "files": [
      "main.js",
      "preload.js",
      "recorder.html",
      "overlay.html",
      "assets/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg"],
      "icon": "assets/icon.png",
      "artifactName": "Tailzu.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Tailzu records your voice to transcribe and clean it into text.",
        "LSUIElement": true
      }
    },
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Tailzu-Setup.${ext}"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "assets/icon.png",
      "artifactName": "Tailzu.${ext}"
    }
  }
}
